```{r}
Population <- c(
  5200000, 12800000, 7600000, 21400000,
  3400000, 9800000, 6100000, 15600000,
  4300000, 18700000, 8900000, 11200000
)

Visits <- c(
  145000, 310000, 225000, 490000,
  98000, 275000, 180000, 360000,
  125000, 410000, 240000, 295000
)

Vaccination_Coverage <- c(
  82.4, 76.8, 91.2, 68.5,
  88.9, 73.6, 84.1, 79.7,
  92.5, 66.9, 81.3, 87.6
)


```

```{r}
country_data <- data.frame(
  Country,
  Population,
  Visits,
  Vaccination_Coverage
)

country_data
```

```{r}
library(dplyr)

country_data <- country_data %>%
  mutate(
    Asthma_Visit_Rate = round((Visits / Population) * 100000, 1)
  )

country_data
```

```{r}
write_csv(country_data, "county_health_data.csv")
